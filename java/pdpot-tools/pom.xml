<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nl.eur.pdpot</groupId>
        <artifactId>pdpot</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>pdpot-tools</artifactId>

    <profiles>
        <profile>
            <id>video</id>
            <dependencies>
                <dependency>
                    <groupId>nl.eur.pdpot</groupId>
                    <artifactId>pdpot-visualizer-video</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>nl.eur.pdpot</groupId>
            <artifactId>pdpot-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>nl.eur.pdpot</groupId>
            <artifactId>pdpot-assign</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>nl.eur.pdpot</groupId>
            <artifactId>pdpot-analyze</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>nl.eur.pdpot</groupId>
            <artifactId>pdpot-visualizer</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <dependency>
            <groupId>hu.webarticum</groupId>
            <artifactId>tree-printer</artifactId>
            <version>${treeprinter.version}</version>
        </dependency>
        <dependency>
            <groupId>me.tongfei</groupId>
            <artifactId>progressbar</artifactId>
            <version>${progressbar.version}</version>
        </dependency>
    </dependencies>

    <build>

        <!-- Resource filtering for version.txt generation -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>


        <plugins>

            <!-- Generate git commit id property -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>${git.commit-id.plugin.version}</version>
                <executions>
                    <execution>
                        <id>get-git-info</id>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                </executions>
                <configuration>
                    <!-- When we are not in a Git checkout we just ignore errors -->
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <!-- Keep the full SHA but we only need the short one later -->
                    <abbrevLength>7</abbrevLength>
                    <!-- Do not write a separate properties file – we only need the
                         values in the Maven property map -->
                    <generateGitPropertiesFile>false</generateGitPropertiesFile>
                </configuration>
            </plugin>

            <!-- Generate version.txt -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven.antrun.plugin.version}</version>
                <executions>
                    <execution>
                        <id>write-version-txt</id>
                        <phase>generate-resources</phase>
                        <configuration>
                            <target>
                                <!-- make sure the directory exists -->
                                <mkdir dir="${project.basedir}/src/main/generated-resources"/>

                                <!-- write the file (place‑holders will be filtered later) -->
                                <echo file="${project.basedir}/src/main/generated-resources/version.txt">
Application-name: ${project.name}
Version: ${project.version}
Buildtime: ${maven.build.timestamp}
Git commit id: ${git.commit.id}
                                </echo>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Copy version.txt -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>generate-version-txt</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/main/generated-resources</directory>
                                    <includes>
                                        <include>version.txt</include>
                                    </includes>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Build a fat jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <!-- Use the same version property you used for the assembly plugin -->
                <version>${maven.shade.plugin.version}</version>

                <executions>
                    <execution>
                        <!-- Run in the same phase that the assembly plugin used -->
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <finalName>${project.artifactId}-${project.version}-fatjar</finalName>

                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>podrouting.tools.cli.ToolsMain</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Signature files – they just clutter the jar -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>